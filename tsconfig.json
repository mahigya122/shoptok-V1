{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "supabase/functions"
  ],
  "extends": "expo/tsconfig.base"
}
